---
import { frameToString, render } from '../lib/axo';
import { figures, type FigureName } from '../lib/scenes';
import type { Legend } from '../lib/content';

interface Props {
  name: FigureName;
  no: string;
  // what the figure shows, read out in place of the drawing
  title: string;
  legend: Legend;
  live?: boolean;
  class?: string;
  id?: string;
}

const { name, no, title, legend, live = false, class: cls, id } = Astro.props;
const def = figures[name];
const frame = render(def.build(def.cam), def.cam);
const [x, y, w, h] = frame.box;
// stroke and type are scaled against this width until the client measures the real one
const k = (w / 560).toFixed(4);
// one line, without the reference numerals, which only mean something to the eye
const lower = (s: string) => (/^[A-Z][a-z]/.test(s) ? s[0].toLowerCase() + s.slice(1) : s);
const parts = legend.map(([, part]) => lower(part));
const plain = `Figure ${no}, ${lower(title)}: ${parts.slice(0, -1).join(', ')} and ${parts.at(-1)}.`;
---

<figure class:list={['fig', cls]} data-fig={name} id={id}>
  <div class="fig-frame" data-nosnippet>
    <svg
      class="axo"
      viewBox={`${x} ${y} ${w} ${h}`}
      data-scene={name}
      data-live={live ? '' : undefined}
      data-box={frame.box.join(' ')}
      style={`--k:${k};aspect-ratio:${w}/${h}`}
      role="img"
      aria-label={plain}
      set:html={frameToString(frame)}
    />
  </div>
  <figcaption>
    {/* the spaces render nothing in these flex rows, but keep numbers and names apart in raw HTML */}
    <span class="fig-no" aria-hidden="true">Fig. {no}</span>{' '}
    <ol class="legend">
      {
        legend.map(([n, part]) => (
          <li>
            <span class="ref" data-ref={n} aria-hidden="true">{n}</span>{' '}
            {part}
          </li>
        ))
      }
    </ol>
  </figcaption>
</figure>
