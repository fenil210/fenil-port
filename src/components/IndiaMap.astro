---
import { geoConicConformal, geoPath } from 'd3-geo';
import { indiaStates as regions, thin } from '../lib/atlas';
import { travel } from '../lib/content';

// union territories are drawn like the states; only the readout tells them apart
const UTS = new Set(['Andaman & Nicobar', 'Chandigarh', 'Dadra and Nagar Haveli and Daman and Diu', 'Delhi', 'Jammu & Kashmir', 'Ladakh', 'Lakshadweep', 'Puducherry']);
const display = (n: string) => n.replace(' & ', ' and ').replace(/^Andaman and Nicobar$/, 'Andaman and Nicobar Islands');
const visited = new Set(travel.states);

const W = 520;
const fc = { type: 'FeatureCollection' as const, features: regions };
const proj = geoConicConformal().parallels([12, 28]).rotate([-80, 0]).fitWidth(W - 2, fc);
const [[, y0], [, y1]] = geoPath(proj).bounds(fc);
const H = Math.ceil(y1 - y0 + 2);
proj.translate([proj.translate()[0] + 1, proj.translate()[1] - y0 + 1]);

// project, then thin each ring to what a screen can show and drop the specks
const draw = (f: (typeof regions)[number]) => {
  const rings: number[][][] = [];
  geoPath(proj, {
    beginPath() {},
    moveTo: (x, y) => void rings.push([[x, y]]),
    lineTo: (x, y) => void rings.at(-1)!.push([x, y]),
    closePath: () => void rings.at(-1)!.push(rings.at(-1)![0]),
    arc() {},
  })(f);
  const area = (r: number[][]) => Math.abs(r.reduce((a, p, i) => a + (i ? r[i - 1][0] * p[1] - p[0] * r[i - 1][1] : 0), 0)) / 2;
  return rings
    .filter((r) => area(r) > 1.5)
    .map((r) => 'M' + thin(r, 0.35).slice(0, -1).map((p) => `${p[0].toFixed(1)} ${p[1].toFixed(1)}`).join('L') + 'Z')
    .join('');
};

const shapes = regions
  .map((f) => {
    const name = f.properties.ST_NM;
    const seen = visited.has(name);
    return { d: draw(f), id: name, name: display(name), seen, note: `${UTS.has(name) ? 'Union territory' : 'State'}, ${seen ? 'visited' : 'not yet'}` };
  })
  // unvisited first, so a hatched state's outline is never painted over
  .sort((a, b) => Number(a.seen) - Number(b.seen));
const seen = shapes.filter((s) => s.seen).map((s) => s.name);
---

<svg class="india-svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Map of India with the ${seen.length} states and union territories visited hatched: ${seen.join(', ')}.`}>
  <defs>
    <pattern id="i-hatch" width="4.5" height="4.5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="4.5"></line>
    </pattern>
  </defs>
  {shapes.map((s) => <path class:list={['region', s.seen && 'seen']} d={s.d} data-id={s.id} data-name={s.name} data-note={s.note} />)}
</svg>
