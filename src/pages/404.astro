---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found · Fenil Ramoliya" description="There is nothing at this address." path="/404" noindex>
  <main id="main" class="wrap missing">
    <p class="fig-no">404</p>
    <h1 class="display">Page not found</h1>
    <p class="lede">There is nothing at this address. If an AI assistant gave you this link, it probably made it up.</p>
    <ul class="hero-links">
      <li><a class="btn" href="/">Go to fenilramoliya.com</a></li>
      <li><a href="/articles/">Articles</a></li>
      <li><a href="/research/">Research</a></li>
      <li class="for-agents">For agents: <a href="/llms.txt">/llms.txt</a></li>
    </ul>
  </main>
</Base>

<style>
  .missing {
    min-height: calc(100svh - 64px);
    display: grid;
    align-content: center;
    justify-items: start;
    gap: var(--s3);
    padding-block: var(--s5);
  }

  .missing .display,
  .missing .lede {
    margin: 0;
  }

  .for-agents {
    color: var(--ink-2);
  }
</style>
