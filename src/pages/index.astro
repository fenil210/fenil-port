---
import Arrow from '../components/Arrow.astro';
import Figure from '../components/Figure.astro';
import IndiaMap from '../components/IndiaMap.astro';
import Matrix from '../components/Matrix.astro';
import Base from '../layouts/Base.astro';
import { articles, fmt, href, iso } from '../lib/articles';
import { atlas } from '../lib/atlas';
import { drawGlobe, SIZE, VIEW } from '../lib/globe';
import { bio, contact, hero, links, meta, papers, path, principles, projects, recognition, research, systems, travel } from '../lib/content';
import { graph } from '../lib/schema';

const writing = await articles();

// experience chart: a year scale from the first stint to the year after today
const asYear = (d: Date) => d.getFullYear() + (d.getMonth() + (d.getDate() - 1) / 31) / 12;
const today = asYear(new Date());
const t0 = Math.floor(Math.min(...path.map((p) => p.from)));
const t1 = Math.ceil(today + 0.15);
const at = (y: number) => +(((y - t0) / (t1 - t0)) * 100).toFixed(3);
const scale = Array.from({ length: t1 - t0 }, (_, i) => t0 + i);
// papers sit as ticks spread across the year they came out, never past today
const ticks = scale.flatMap((y) => {
  const these = papers.filter((p) => p.y === y);
  const span = Math.min(1, today - y);
  return these.map((p, i) => ({ x: at(y + ((i + 0.5) / these.length) * span), j: !!p.j }));
});
// a riser joins each job to the one before it
const prev = (i: number) => (path[i].kind === 'job' && path[i + 1]?.kind === 'job' ? path[i + 1] : undefined);

// a visit is traced through these, in page order: Fig. 11 and the masthead's bottom edge
const spans = [
  { id: 'top', name: 'Introduction' },
  { id: 'work', name: 'Systems' },
  { id: 'research', name: 'Research' },
  { id: 'projects', name: 'Projects' },
  { id: 'articles', name: 'Articles' },
  { id: 'experience', name: 'Experience' },
  { id: 'travel', name: 'Travel' },
  { id: 'contact', name: 'Contact' },
];
---

<Base title={meta.title} description={meta.description} path="/" graph={graph(Astro.site!)} markdown="/index.md" spans={spans} traceNo="11">
  <Fragment slot="head">
    <!-- iMessage plays this in the link preview; everything else shows the image -->
    <meta property="og:video" content={new URL('/og.mp4', Astro.site)} />
    <meta property="og:video:secure_url" content={new URL('/og.mp4', Astro.site)} />
    <meta property="og:video:type" content="video/mp4" />
    <meta property="og:video:width" content="1200" />
    <meta property="og:video:height" content="630" />
  </Fragment>

    <main id="main">
      <section class="hero wrap" id="top">
        <div class="hero-copy">
          <!-- the space keeps the two lines one sentence for crawlers that ignore CSS -->
          <h1 class="display">{hero.title.map((t) => <><span>{t}</span>{' '}</>)}</h1>
          <p class="lede">{hero.lede}</p>
          <ul class="hero-links">
            <li><a class="btn" href={`mailto:${links.email}`}>Write to me</a></li>
            <li><a href={links.github} rel="me">GitHub</a></li>
            <li><a href={links.linkedin} rel="me">LinkedIn</a></li>
            <li><a href={links.scholar}>Scholar</a></li>
            <li><a href={links.x} rel="me">X</a></li>
          </ul>
        </div>
        <Figure name="hero" no="1" title="an agent system" legend={hero.legend} live class="hero-fig" />
      </section>

      <section class="section wrap" id="work">
        <h2 class="section-head">Systems in production</h2>

        <div class="systems">
          <div class="systems-list">
            {
              systems.map((s) => (
                <article class="system" id={s.id} data-fig={s.fig}>
                  <h3>{s.name}</h3>
                  <p class="body">{s.body}</p>
                  <ul class="inside">
                    {s.inside.map((i) => <li>{i}</li>)}
                  </ul>
                  <p class="stack">{s.stack}</p>
                  <div class="fig-slot" />
                </article>
              ))
            }
          </div>
          <div class="systems-stage" aria-live="off">
            <div class="stage-inner">
              {systems.map((s, i) => <Figure name={s.fig} no={s.figNo} title={s.name} legend={s.legend} class:list={['stage-fig', i === 0 && 'on']} />)}
            </div>
          </div>
        </div>

        <div class="recognition principles">
          <p class="label-inline">Building for research</p>
          <ul>
            {
              principles.map((p) => (
                <li>
                  <span class="what">{p.name}</span>
                  <span class="where">{p.text}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="section wrap" id="research">
        <h2 class="section-head">Research</h2>

        <dl class="stats">
          {
            research.stats.map((s) => (
              <div>
                <dt>{s.value}</dt>
                <dd>{s.label}</dd>
              </div>
            ))
          }
        </dl>

        <Matrix no="7" />

        <div class="papers">
          <p class="label-inline">Most cited</p>
          <ol>
            {
              research.selected.map((p) => (
                <li>
                  <p class="paper-title"><a href={`/research/#${p.id}`}>{p.t}</a></p>
                  <p class="paper-meta">
                    {p.v}, {p.y}
                    {p.first && <span> · first author</span>}
                    {p.c && <span> · {p.c} citations</span>}
                  </p>
                </li>
              ))
            }
          </ol>
        </div>
        <p class="more"><a href="/research/">All {papers.length} papers, with authors and DOIs</a></p>
      </section>

      <section class="section wrap" id="projects">
        <h2 class="section-head">Projects</h2>
        <ol class="rows projects">
          {
            projects.map((p) => (
              <li>
                <a href={p.href}>
                  <span class="row-year">{p.year}</span>
                  <span class="row-name">{p.name}</span>
                  <span class="row-text">{p.text}</span>
                  <Arrow />
                </a>
              </li>
            ))
          }
        </ol>
        <p class="more"><a href={links.github}>All repositories on GitHub</a></p>
      </section>

      <section class="section wrap" id="articles">
        <h2 class="section-head">Articles</h2>
        <ol class="rows notes">
          {
            writing.map((w) => (
              <li>
                <a href={href(w)}>
                  <time datetime={iso(w.data.date)}>{fmt(w.data.date)}</time>
                  <span class="row-name">{w.data.title}</span>
                  <Arrow />
                </a>
              </li>
            ))
          }
        </ol>
        <p class="more"><a href="/articles/">All articles</a></p>
      </section>

      <section class="section wrap" id="experience">
        <h2 class="section-head">Experience</h2>
        <p class="section-dek">{bio}</p>
        <div class="chart" data-t0={t0} data-t1={t1} style={`--now:${at(today)};--years:${t1 - t0}`}>
          <div class="chart-axis lane" aria-hidden="true">
            {
              scale.map((y) => (
                <span class="year" style={`--x:${at(y)}`}>
                  <span class="long">{y}</span>
                  <span class="short">’{String(y).slice(2)}</span>
                </span>
              ))
            }
            <span class="now-label">Now</span>
          </div>
          <ol class="chart-rows">
            {
              path.map((p, i) => (
                <li class:list={['stint', p.kind, p.to === undefined && 'current']} style={`--i:${path.length - 1 - i}`}>
                  <p class="stint-label">
                    <span class="role">{p.role}</span>
                    <span class="where">{p.where}</span>
                    <span class="dates">{p.when}</span>
                  </p>
                  <div class="lane" aria-hidden="true">
                    {p.kind === 'pubs' ? (
                      ticks.map((t) => <span class:list={['tick', t.j && 'journal']} style={`--x:${t.x}`} />)
                    ) : (
                      <span class="bar" style={`--a:${at(p.from)};--b:${p.to === undefined ? 'var(--now)' : at(p.to)}`} />
                    )}
                    {prev(i) && <span class="riser" style={`--a:${at(prev(i)!.to!)};--b:${at(p.from)}`} />}
                    {p.to === undefined && <span class="live" />}
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
        <div class="recognition">
          <p class="label-inline">Recognition</p>
          <ul>
            {
              recognition.map((r) => (
                <li>
                  <span class="what">{r.what}</span>
                  <span class="where">{r.where}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="section wrap" id="travel">
        <h2 class="section-head">Travel</h2>
        <p class="section-dek">{travel.dek}</p>

        <dl class="stats">
          <div><dt>{travel.countries.length}</dt><dd>countries abroad</dd></div>
          <div><dt>{travel.continents}</dt><dd>continents</dd></div>
          <div><dt>{travel.states.length}</dt><dd>states and union territories of India</dd></div>
        </dl>

        <div class="atlas">
          <figure class="fig globe" id="fig-9">
            <div class="globe-frame" data-nosnippet>
              <svg class="globe-svg" viewBox={`0 0 ${SIZE} ${SIZE}`} role="img" aria-label={`Globe with arcs to ${travel.countries.map((c) => c.name).join(', ')}, and the night side shaded as it is now.`}>
                <defs>
                  <pattern id="g-hatch" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                    <line x1="0" y1="0" x2="0" y2="5"></line>
                  </pattern>
                </defs>
                <g class="globe-body" set:html={drawGlobe(atlas, { rotate: VIEW, now: new Date() })} />
              </svg>
            </div>
            <figcaption>
              <span class="fig-no" aria-hidden="true">Fig. 9</span>{' '}
              <div class="places">
                <ol>
                  {
                    travel.countries.map((c, i) => (
                      <li data-id={c.id} data-at={atlas.places[i].at.join(' ')}>
                        <span class="ref" aria-hidden="true">{i + 1}</span>{' '}
                        <span class="place">{c.name}</span>
                        <time class="tz" data-tz={c.tz} />
                        <span class="key sky" />
                      </li>
                    ))
                  }
                </ol>
                <p class="keys"><span class="key key-night"></span>Night there now <span class="key"></span>Day</p>
              </div>
            </figcaption>
          </figure>

          <figure class="fig india" id="fig-10">
            <IndiaMap />
            <figcaption>
              <span class="fig-no" aria-hidden="true">Fig. 10</span>{' '}
              <div class="places">
                <ul class="states">{travel.states.map((s) => <li data-id={s}>{s.replace(' & ', ' and ')}</li>)}</ul>
                <p class="keys readout" aria-live="polite">
                  <span class="readout-default"><span class="key key-hatch"></span>Visited</span>
                  <span class="readout-on"><b></b> <span></span></span>
                </p>
              </div>
            </figcaption>
          </figure>
        </div>
      </section>

      <section class="section wrap contact" id="contact">
        <h2 class="section-head">Contact</h2>
        <p class="contact-mail">
          <a href={`mailto:${links.email}`}>{links.email.split('@')[0]}<wbr />@{links.email.split('@')[1]}</a>
        </p>
        <p class="intro">
          {contact.intro}{' '}
          <span class="clock" data-tz="Asia/Kolkata">{contact.home}</span>
        </p>
        <ul class="contact-links">
          <li><a href={links.github} rel="me">GitHub</a></li>
          <li><a href={links.linkedin} rel="me">LinkedIn</a></li>
          <li><a href={links.scholar}>Google Scholar</a></li>
          <li><a href={links.x} rel="me">X</a></li>
        </ul>
      </section>
    </main>

    <script>
      import '../scripts/main';
    </script>
</Base>
