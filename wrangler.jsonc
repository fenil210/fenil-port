// Cloudflare Workers serves the built site as static files. Only the preview video goes
// through worker/index.ts first, so that it can answer byte-range requests.
{
  "name": "fenil-ramoliya",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/og.mp4"] },
  // copied from the dashboard as is, so a deploy from here changes nothing there
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
    "traces": { "enabled": true, "head_sampling_rate": 1, "persist": true },
    "issue_detection": { "enabled": false }
  }
}
